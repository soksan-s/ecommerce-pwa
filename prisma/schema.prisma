generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum OtpPurpose {
  VERIFY_PHONE
  RESET_PASSWORD
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  CASHIER
  WAREHOUSE_STAFF
  DRIVER
  CLIENT
}

enum SalesChannel {
  POS
  ONLINE
  WHOLESALE
}

enum SaleStatus {
  OPEN
  COMPLETED
  VOIDED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PICKING
  PACKING
  READY
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  RETURNED
  REFUNDED
  PROCESSING
  PREPARING
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
  VOIDED
}

enum PurchaseStatus {
  DRAFT
  PENDING
  APPROVED
  PARTIAL_RECEIVED
  RECEIVED
  CANCELLED
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum CustomerTypeCode {
  RETAIL
  WHOLESALE
  VIP
  DISTRIBUTOR
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT_INCREASE
  ADJUSTMENT_DECREASE
  SALE
  SALE_RETURN
  PURCHASE_RECEIPT
  PURCHASE_RETURN
  TRANSFER_IN
  TRANSFER_OUT
  STOCK_COUNT_INCREASE
  STOCK_COUNT_DECREASE
  WASTE
  RESERVATION
  RESERVATION_RELEASE
}

enum StockTransferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum StockCountStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  BUY_X_GET_Y
  FLASH_SALE
  HAPPY_HOUR
  FREE_SHIPPING
  CATEGORY_DISCOUNT
  BRAND_DISCOUNT
}

enum CouponType {
  PERCENT
  FIXED
}

enum CouponAudience {
  EVERYONE
  USER
  CUSTOMER_TYPE
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum SyncStatus {
  PENDING
  SYNCED
  CONFLICT
  FAILED
  RETRYING
}

enum DriverStatus {
  AVAILABLE
  BUSY
  OFFLINE
  ON_LEAVE
}

enum ShiftStatus {
  OPEN
  CLOSED
  DISCREPANCY
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  STOCK_CHANGE
  LOGIN
  LOGOUT
  PERMISSION_CHANGE
  STOCK_IN
  STOCK_ADJUSTMENT
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  EXPIRE
  ADJUST_INCREASE
  ADJUST_DECREASE
}

enum CreditTransactionType {
  CHARGE
  PAYMENT
  ADJUSTMENT
  WRITE_OFF
}

enum ContainerTransactionType {
  ISSUE
  RETURN
}

enum ReturnReason {
  DEFECTIVE
  WRONG_ITEM
  CUSTOMER_CHANGED_MIND
  EXCESS_ORDER
  EXPIRED
  OTHER
}

enum CashDrawerTransactionType {
  OPEN
  CLOSE
  CASH_IN
  CASH_OUT
  SALE
  REFUND
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

enum CostingMethod {
  FIFO
  LIFO
  WEIGHTED_AVERAGE
}

enum NotificationType {
  LOW_STOCK
  EXPIRY_WARNING
  ORDER_PLACED
  ORDER_STATUS_CHANGE
  PAYMENT_RECEIVED
  SYNC_FAILURE
  SYSTEM
}

// ==========================================
// 1. CORE
// ==========================================

model Branch {
  id                   String                  @id @default(cuid())
  code                 String                  @unique
  name                 String
  nameKh               String?
  phone                String
  email                String?
  address              String
  addressKh            String?
  lat                  Decimal?                @db.Decimal(10, 7)
  lng                  Decimal?                @db.Decimal(10, 7)
  status               BranchStatus            @default(ACTIVE)
  costingMethod        CostingMethod           @default(FIFO)
  currencyCode         String                  @default("USD")
  users                User[]
  inventory            Inventory[]
  inventoryBatches     InventoryBatch[]
  inventoryMovements   InventoryMovement[]
  inventoryAdjustments InventoryAdjustment[]
  stockTransfersFrom   StockTransfer[]         @relation("TransferFrom")
  stockTransfersTo     StockTransfer[]         @relation("TransferTo")
  stockCounts          StockCount[]
  sales                Sale[]
  orders               Order[]
  shifts               Shift[]
  cashDrawerTx         CashDrawerTransaction[]
  payments             Payment[]
  credits              CustomerCredit[]
  containerTx          ContainerTransaction[]
  purchaseOrders       PurchaseOrder[]
  supplierPayments     SupplierPayment[]
  expenses             Expense[]
  notifications        Notification[]
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  deletedAt            DateTime?

  @@index([status])
  @@index([deletedAt])
}

model User {
  id                      String                @id @default(cuid())
  email                   String?
  emailVerified           Boolean               @default(false)
  image                   String?
  username                String?
  passwordHash            String?
  phoneNumber             String                @unique
  phoneNumberVerified     Boolean               @default(false)
  role                    UserRole              @default(CLIENT)
  roleId                  String?
  branchId                String?
  name                    String?
  nameKh                  String?
  avatarUrl               String?
  status                  UserStatus            @default(ACTIVE)
  lastLoginAt             DateTime?
  passwordChangedAt       DateTime?
  roleRef                 Role?                 @relation(fields: [roleId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  branch                  Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  orders                  Order[]
  favorites               Favorite[]
  comments                Comment[]             @relation("CommentAuthor")
  supportTickets          SupportTicket[]
  supportReplies          SupportMessage[]
  shifts                  Shift[]
  goodsReceipts           GoodsReceipt[]
  auditLogs               AuditLog[]
  stockTransfersRequested StockTransfer[]       @relation("TransferRequester")
  stockTransfersApproved  StockTransfer[]       @relation("TransferApprover")
  stockCounts             StockCount[]
  expenses                Expense[]
  inventoryAdjustments    InventoryAdjustment[]
  notifications           Notification[]
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  deletedAt               DateTime?
  sessions                Session[]
  accounts                Account[]

  @@index([phoneNumber])
  @@index([email])
  @@index([branchId])
  @@index([role])
  @@index([status])
  @@index([deletedAt])
}

model Otp {
  id        String     @id @default(cuid())
  phone     String
  codeHash  String
  purpose   OtpPurpose
  expiresAt DateTime
  attempts  Int        @default(0)
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([phone])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  module      String
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([module])
}

model RolePermission {
  roleId       String
  permissionId String
  grantedAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleId, permissionId])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Retained for backward compatibility
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Retained for backward compatibility
model SystemSettings {
  id           String   @id @default(cuid())
  usdToKhrRate Int      @default(4000)
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  action    AuditAction
  module    String
  recordId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt DateTime    @default(now())

  @@index([module, createdAt])
  @@index([userId, createdAt])
  @@index([recordId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String?
  branchId  String?
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  data      Json?
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  branch    Branch?          @relation(fields: [branchId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([branchId, isRead])
}

// ==========================================
// 2. PRODUCT CATALOG
// ==========================================

model Category {
  id          String     @id @default(cuid())
  name        String
  nameKh      String?
  slug        String     @unique
  parentId    String?
  description String?
  imageUrl    String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
  @@index([isActive])
}

model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  nameKh      String?
  slug        String    @unique
  logoUrl     String?
  description String?
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Unit {
  id               String           @id @default(cuid())
  name             String           @unique
  nameKh           String?
  abbreviation     String
  baseUnitId       String?
  conversionFactor Decimal?         @db.Decimal(12, 6)
  baseUnit         Unit?            @relation("UnitConversion", fields: [baseUnitId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  derivedUnits     Unit[]           @relation("UnitConversion")
  variants         ProductVariant[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model Tax {
  id        String    @id @default(cuid())
  name      String    @unique
  nameKh    String?
  rate      Decimal   @db.Decimal(5, 4)
  type      String    @default("EXCLUSIVE")
  isDefault Boolean   @default(false)
  isActive  Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id              String           @id @default(cuid())
  sku             String?          @unique
  name            String
  nameKh          String?
  slug            String?          @unique
  description     String?
  descriptionKh   String?
  categoryId      String?
  brandId         String?
  taxId           String?
  imageUrl        String?
  minStockAlert   Int              @default(5)
  isActive        Boolean          @default(true)
  isVariant       Boolean          @default(false)
  ratingAvg       Decimal          @default(0) @db.Decimal(3, 2)
  ratingCount     Int              @default(0)
  sortOrder       Int              @default(0)
  // Legacy fields retained for backward compatibility
  brand           String?
  category        String?
  price           Decimal?         @db.Decimal(10, 2)
  costPrice       Decimal?         @db.Decimal(10, 2)
  wholesalePrice  Decimal?         @db.Decimal(10, 2)
  vipPrice        Decimal?         @db.Decimal(10, 2)
  discountPercent Int              @default(0)
  discountStart   DateTime?
  discountEnd     DateTime?
  stock           Int              @default(0)
  barcode         String?          @unique
  categoryRef     Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  brandRef        Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  tax             Tax?             @relation(fields: [taxId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  variants        ProductVariant[]
  images          ProductImage[]
  barcodes        ProductBarcode[]
  tags            ProductTagItem[]
  deposits        ProductDeposit[]
  favorites       Favorite[]
  comments        Comment[]
  reviews         ProductReview[]
  promotionItems  PromotionItem[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive])
  @@index([deletedAt])
}

model ProductVariant {
  id                  String                    @id @default(cuid())
  productId           String
  sku                 String                    @unique
  name                String
  nameKh              String?
  unitId              String?
  // All prices live here — never on Product
  price               Decimal                   @db.Decimal(10, 2)
  costPrice           Decimal?                  @db.Decimal(10, 2)
  wholesalePrice      Decimal?                  @db.Decimal(10, 2)
  vipPrice            Decimal?                  @db.Decimal(10, 2)
  discountPercent     Int                       @default(0)
  discountStart       DateTime?
  discountEnd         DateTime?
  weight              Decimal?                  @db.Decimal(10, 3)
  volume              Decimal?                  @db.Decimal(10, 3)
  barcode             String?                   @unique
  isActive            Boolean                   @default(true)
  sortOrder           Int                       @default(0)
  product             Product                   @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  unit                Unit?                     @relation(fields: [unitId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  attributeValues     VariantAttributeValue[]
  images              VariantImage[]
  priceTiers          ProductPriceTier[]
  inventory           Inventory[]
  batches             InventoryBatch[]
  movements           InventoryMovement[]
  adjustmentItems     InventoryAdjustmentItem[]
  stockReservations   StockReservation[]
  costHistory         InventoryCostHistory[]
  stockTransferItems  StockTransferItem[]
  stockCountItems     StockCountItem[]
  saleItems           SaleItem[]
  orderItems          OrderItem[]
  poItems             PurchaseOrderItem[]
  grItems             GoodsReceiptItem[]
  purchaseReturnItems PurchaseReturnItem[]
  returnItems         ReturnItem[]
  cartItems           CartItem[]
  wishlistItems       WishlistItem[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([productId])
  @@index([sku])
  @@index([barcode])
  @@index([isActive])
}

model VariantAttribute {
  id        String                  @id @default(cuid())
  name      String                  @unique
  nameKh    String?
  values    VariantAttributeValue[]
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
}

model VariantAttributeValue {
  id          String           @id @default(cuid())
  attributeId String
  variantId   String
  value       String
  attribute   VariantAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variant     ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([attributeId, variantId])
  @@index([variantId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([productId])
}

model VariantImage {
  id        String         @id @default(cuid())
  variantId String
  url       String
  altText   String?
  sortOrder Int            @default(0)
  isPrimary Boolean        @default(false)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([variantId])
}

model ProductBarcode {
  id        String  @id @default(cuid())
  productId String
  barcode   String  @unique
  type      String  @default("EAN13")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([barcode])
  @@index([productId])
}

model ProductTag {
  id        String           @id @default(cuid())
  name      String           @unique
  slug      String           @unique
  items     ProductTagItem[]
  createdAt DateTime         @default(now())
}

model ProductTagItem {
  productId String
  tagId     String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tag       ProductTag @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([productId, tagId])
}

model ProductPriceTier {
  id             String         @id @default(cuid())
  variantId      String
  customerTypeId String?
  minQty         Int            @default(1)
  maxQty         Int?
  price          Decimal        @db.Decimal(10, 2)
  currency       String         @default("USD")
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean        @default(true)
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  customerType   CustomerType?  @relation(fields: [customerTypeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([variantId, minQty])
  @@index([customerTypeId])
}

model DepositType {
  id              String                 @id @default(cuid())
  name            String                 @unique
  nameKh          String?
  description     String?
  depositAmount   Decimal                @db.Decimal(10, 2)
  productDeposits ProductDeposit[]
  containerTx     ContainerTransaction[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
}

model ProductDeposit {
  id            String      @id @default(cuid())
  productId     String
  depositTypeId String
  quantity      Int         @default(1)
  depositAmount Decimal     @db.Decimal(10, 2)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  depositType   DepositType @relation(fields: [depositTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([productId, depositTypeId])
}

// ==========================================
// 3. INVENTORY
// ==========================================

model Inventory {
  id                String         @id @default(cuid())
  variantId         String
  branchId          String
  quantity          Int            @default(0)
  reservedQuantity  Int            @default(0)
  availableQuantity Int            @default(0)
  minStockLevel     Int            @default(0)
  maxStockLevel     Int?
  reorderPoint      Int            @default(0)
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  branch            Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  updatedAt         DateTime       @updatedAt

  @@unique([variantId, branchId])
  @@index([branchId])
  @@index([variantId])
}

model InventoryBatch {
  id               String              @id @default(cuid())
  batchNumber      String
  variantId        String
  branchId         String
  supplierId       String?
  purchaseOrderId  String?
  goodsReceiptId   String?
  initialQty       Int                 @default(0)
  remainingQty     Int                 @default(0)
  costPrice        Decimal             @db.Decimal(10, 2)
  currency         String              @default("USD")
  manufacturedDate DateTime?
  expiryDate       DateTime?
  receivedDate     DateTime            @default(now())
  isActive         Boolean             @default(true)
  variant          ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  branch           Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  supplier         Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  movements        InventoryMovement[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([batchNumber, variantId, branchId])
  @@index([variantId, branchId])
  @@index([expiryDate])
  @@index([branchId, expiryDate])
}

model InventoryMovement {
  id              String                @id @default(cuid())
  variantId       String
  branchId        String?
  batchId         String?
  saleId          String?
  orderId         String?
  stockTransferId String?
  adjustmentId    String?
  type            InventoryMovementType
  channel         SalesChannel?
  quantityBefore  Int
  quantityChange  Int
  quantityAfter   Int
  costPrice       Decimal?              @db.Decimal(10, 2)
  note            String?
  userId          String?
  variant         ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch          Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  batch           InventoryBatch?       @relation(fields: [batchId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sale            Sale?                 @relation(fields: [saleId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  order           Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  stockTransfer   StockTransfer?        @relation(fields: [stockTransferId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt       DateTime              @default(now())

  @@index([variantId, createdAt])
  @@index([branchId, createdAt])
  @@index([type, createdAt])
  @@index([saleId])
  @@index([orderId])
}

model InventoryAdjustment {
  id        String                    @id @default(cuid())
  branchId  String
  userId    String
  reason    String
  note      String?
  status    String                    @default("APPROVED")
  items     InventoryAdjustmentItem[]
  branch    Branch                    @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user      User                      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  @@index([branchId, createdAt])
}

model InventoryAdjustmentItem {
  id           String              @id @default(cuid())
  adjustmentId String
  variantId    String
  batchId      String?
  qtyBefore    Int
  qtyChange    Int
  qtyAfter     Int
  costPrice    Decimal?            @db.Decimal(10, 2)
  reason       String?
  adjustment   InventoryAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variant      ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([adjustmentId])
  @@index([variantId])
}

model InventoryCostHistory {
  id          String         @id @default(cuid())
  variantId   String
  branchId    String?
  costPrice   Decimal        @db.Decimal(10, 2)
  currency    String         @default("USD")
  source      String
  referenceId String?
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt   DateTime       @default(now())

  @@index([variantId, createdAt])
}

model StockReservation {
  id        String         @id @default(cuid())
  variantId String
  branchId  String
  orderId   String?
  cartId    String?
  quantity  Int
  expiresAt DateTime?
  isActive  Boolean        @default(true)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime       @default(now())

  @@index([variantId, branchId])
  @@index([orderId])
  @@index([expiresAt, isActive])
}

model StockTransfer {
  id             String              @id @default(cuid())
  transferNumber String              @unique
  fromBranchId   String
  toBranchId     String
  requestedById  String
  approvedById   String?
  status         StockTransferStatus @default(DRAFT)
  note           String?
  transferredAt  DateTime?
  receivedAt     DateTime?
  items          StockTransferItem[]
  movements      InventoryMovement[]
  fromBranch     Branch              @relation("TransferFrom", fields: [fromBranchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  toBranch       Branch              @relation("TransferTo", fields: [toBranchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  requestedBy    User                @relation("TransferRequester", fields: [requestedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  approvedBy     User?               @relation("TransferApprover", fields: [approvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([fromBranchId, status])
  @@index([toBranchId, status])
  @@index([transferNumber])
}

model StockTransferItem {
  id             String         @id @default(cuid())
  transferId     String
  variantId      String
  batchId        String?
  requestedQty   Int
  transferredQty Int            @default(0)
  receivedQty    Int            @default(0)
  costPrice      Decimal?       @db.Decimal(10, 2)
  note           String?
  transfer       StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([transferId])
  @@index([variantId])
}

model StockCount {
  id          String           @id @default(cuid())
  countNumber String           @unique
  branchId    String
  userId      String
  status      StockCountStatus @default(DRAFT)
  note        String?
  countedAt   DateTime?
  completedAt DateTime?
  items       StockCountItem[]
  branch      Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([branchId, status])
}

model StockCountItem {
  id           String         @id @default(cuid())
  stockCountId String
  variantId    String
  batchId      String?
  systemQty    Int
  countedQty   Int            @default(0)
  discrepancy  Int            @default(0)
  note         String?
  stockCount   StockCount     @relation(fields: [stockCountId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([stockCountId])
  @@index([variantId])
}

// ==========================================
// 4. PURCHASING & SUPPLIER MANAGEMENT
// ==========================================

model Supplier {
  id             String            @id @default(cuid())
  code           String?           @unique
  name           String
  nameKh         String?
  contactPerson  String?
  phone          String
  email          String?
  address        String?
  taxId          String?
  paymentTerms   Int               @default(0)
  creditLimit    Decimal           @default(0) @db.Decimal(10, 2)
  status         SupplierStatus    @default(ACTIVE)
  purchaseOrders PurchaseOrder[]
  payments       SupplierPayment[]
  batches        InventoryBatch[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  @@index([status])
  @@index([deletedAt])
}

model SupplierPayment {
  id              String   @id @default(cuid())
  supplierId      String
  branchId        String?
  purchaseOrderId String?
  amount          Decimal  @db.Decimal(10, 2)
  currency        String   @default("USD")
  exchangeRate    Decimal  @default(1) @db.Decimal(10, 4)
  baseAmount      Decimal  @db.Decimal(10, 2)
  method          String
  reference       String?
  note            String?
  paidAt          DateTime @default(now())
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch          Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt       DateTime @default(now())

  @@index([supplierId, createdAt])
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  poNumber       String              @unique
  supplierId     String
  branchId       String
  status         PurchaseStatus      @default(DRAFT)
  currency       String              @default("USD")
  exchangeRate   Decimal             @default(1) @db.Decimal(10, 4)
  subtotal       Decimal             @db.Decimal(10, 2)
  taxAmount      Decimal             @default(0) @db.Decimal(10, 2)
  discountAmount Decimal             @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal             @db.Decimal(10, 2)
  paidAmount     Decimal             @default(0) @db.Decimal(10, 2)
  note           String?
  expectedDate   DateTime?
  approvedById   String?
  approvedAt     DateTime?
  supplier       Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch         Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items          PurchaseOrderItem[]
  receipts       GoodsReceipt[]
  returns        PurchaseReturn[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([supplierId, status])
  @@index([branchId, status])
  @@index([poNumber])
}

model PurchaseOrderItem {
  id              String         @id @default(cuid())
  purchaseOrderId String
  variantId       String
  orderedQty      Int
  receivedQty     Int            @default(0)
  unitCost        Decimal        @db.Decimal(10, 2)
  taxPercent      Decimal        @default(0) @db.Decimal(5, 4)
  discountPercent Decimal        @default(0) @db.Decimal(5, 4)
  lineTotal       Decimal        @db.Decimal(10, 2)
  note            String?
  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([purchaseOrderId])
  @@index([variantId])
}

model GoodsReceipt {
  id              String             @id @default(cuid())
  grNumber        String             @unique
  purchaseOrderId String
  branchId        String?
  receivedById    String
  status          String             @default("COMPLETED")
  note            String?
  receivedDate    DateTime           @default(now())
  items           GoodsReceiptItem[]
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  receivedBy      User               @relation(fields: [receivedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([purchaseOrderId])
  @@index([grNumber])
}

model GoodsReceiptItem {
  id               String         @id @default(cuid())
  goodsReceiptId   String
  variantId        String
  batchId          String?
  batchNumber      String?
  orderedQty       Int
  receivedQty      Int
  rejectedQty      Int            @default(0)
  unitCost         Decimal        @db.Decimal(10, 2)
  expiryDate       DateTime?
  manufacturedDate DateTime?
  note             String?
  goodsReceipt     GoodsReceipt   @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([goodsReceiptId])
  @@index([variantId])
}

model PurchaseReturn {
  id              String               @id @default(cuid())
  returnNumber    String               @unique
  purchaseOrderId String
  supplierId      String?
  branchId        String?
  reason          String
  totalAmount     Decimal              @db.Decimal(10, 2)
  status          String               @default("PENDING")
  note            String?
  items           PurchaseReturnItem[]
  purchaseOrder   PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([purchaseOrderId])
}

model PurchaseReturnItem {
  id               String         @id @default(cuid())
  purchaseReturnId String
  variantId        String
  quantity         Int
  unitCost         Decimal        @db.Decimal(10, 2)
  reason           String?
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([purchaseReturnId])
  @@index([variantId])
}

// ==========================================
// 5. CUSTOMER & LOYALTY
// ==========================================

model CustomerType {
  id          String             @id @default(cuid())
  code        CustomerTypeCode   @unique
  name        String
  nameKh      String?
  description String?
  customers   Customer[]
  priceTiers  ProductPriceTier[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model Customer {
  id             String                 @id @default(cuid())
  code           String?                @unique
  name           String
  nameKh         String?
  phone          String                 @unique
  email          String?
  customerTypeId String
  creditLimit    Decimal                @default(0) @db.Decimal(10, 2)
  creditBalance  Decimal                @default(0) @db.Decimal(10, 2)
  loyaltyPoints  Int                    @default(0)
  dateOfBirth    DateTime?
  avatarUrl      String?
  isActive       Boolean                @default(true)
  customerType   CustomerType           @relation(fields: [customerTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  addresses      CustomerAddress[]
  notes          CustomerNote[]
  credits        CustomerCredit[]
  loyaltyAccount LoyaltyAccount?
  containerTx    ContainerTransaction[]
  sales          Sale[]
  orders         Order[]
  carts          Cart[]
  wishlists      Wishlist[]
  payments       CustomerPayment[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  deletedAt      DateTime?

  @@index([phone])
  @@index([customerTypeId])
  @@index([isActive])
  @@index([deletedAt])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  label      String?
  address    String
  city       String?
  province   String?
  country    String   @default("KH")
  lat        Decimal? @db.Decimal(10, 7)
  lng        Decimal? @db.Decimal(10, 7)
  isDefault  Boolean  @default(false)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([customerId])
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  note       String
  cashierId  String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model CustomerCredit {
  id         String                @id @default(cuid())
  customerId String
  branchId   String?
  saleId     String?
  type       CreditTransactionType
  amount     Decimal               @db.Decimal(10, 2)
  balance    Decimal               @db.Decimal(10, 2)
  dueDate    DateTime?
  note       String?
  customer   Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  branch     Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt  DateTime              @default(now())

  @@index([customerId, createdAt])
  @@index([branchId, createdAt])
}

model CustomerPayment {
  id           String   @id @default(cuid())
  customerId   String
  branchId     String?
  amount       Decimal  @db.Decimal(10, 2)
  currency     String   @default("USD")
  exchangeRate Decimal  @default(1) @db.Decimal(10, 4)
  baseAmount   Decimal  @db.Decimal(10, 2)
  method       String
  reference    String?
  note         String?
  paidAt       DateTime @default(now())
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt    DateTime @default(now())

  @@index([customerId, createdAt])
}

model LoyaltyAccount {
  id             String               @id @default(cuid())
  customerId     String               @unique
  totalEarned    Int                  @default(0)
  totalRedeemed  Int                  @default(0)
  currentBalance Int                  @default(0)
  tierLevel      String               @default("STANDARD")
  customer       Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  transactions   LoyaltyTransaction[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model LoyaltyTransaction {
  id               String                 @id @default(cuid())
  loyaltyAccountId String
  type             LoyaltyTransactionType
  points           Int
  balanceBefore    Int
  balanceAfter     Int
  saleId           String?
  orderId          String?
  note             String?
  expiresAt        DateTime?
  loyaltyAccount   LoyaltyAccount         @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt        DateTime               @default(now())

  @@index([loyaltyAccountId, createdAt])
  @@index([expiresAt])
}

model Wishlist {
  id         String         @id @default(cuid())
  customerId String
  name       String         @default("My Wishlist")
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  items      WishlistItem[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([customerId])
}

model WishlistItem {
  id         String         @id @default(cuid())
  wishlistId String
  variantId  String
  wishlist   Wishlist       @relation(fields: [wishlistId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  addedAt    DateTime       @default(now())

  @@unique([wishlistId, variantId])
}

// ==========================================
// 6. SALES & POS OPERATIONS
// ==========================================

model Shift {
  id           String                  @id @default(cuid())
  cashierId    String
  branchId     String?
  openTime     DateTime                @default(now())
  closeTime    DateTime?
  startCash    Decimal                 @db.Decimal(10, 2)
  endCashCalc  Decimal?                @db.Decimal(10, 2)
  endCashPhys  Decimal?                @db.Decimal(10, 2)
  discrepancy  Decimal?                @db.Decimal(10, 2)
  status       ShiftStatus             @default(OPEN)
  note         String?
  sales        Sale[]
  cashDrawerTx CashDrawerTransaction[]
  user         User                    @relation(fields: [cashierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch       Branch?                 @relation(fields: [branchId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([cashierId, status])
  @@index([branchId, status])
}

model CashDrawerTransaction {
  id        String                    @id @default(cuid())
  shiftId   String
  branchId  String?
  type      CashDrawerTransactionType
  amount    Decimal                   @db.Decimal(10, 2)
  currency  String                    @default("USD")
  saleId    String?
  note      String?
  userId    String?
  shift     Shift                     @relation(fields: [shiftId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  branch    Branch?                   @relation(fields: [branchId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt DateTime                  @default(now())

  @@index([shiftId])
  @@index([branchId, createdAt])
}

model Sale {
  id            String                 @id @default(cuid())
  receiptNumber String?                @unique
  channel       SalesChannel           @default(POS)
  status        SaleStatus             @default(COMPLETED)
  branchId      String?
  cashierUserId String?
  cashierName   String?
  customerId    String?
  shiftId       String?
  subtotal      Decimal                @db.Decimal(10, 2)
  discount      Decimal                @default(0) @db.Decimal(10, 2)
  discountType  DiscountType?
  tax           Decimal                @default(0) @db.Decimal(10, 2)
  total         Decimal                @db.Decimal(10, 2)
  currency      String                 @default("USD")
  exchangeRate  Decimal                @default(1) @db.Decimal(10, 4)
  note          String?
  synced        Boolean                @default(true)
  branch        Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  customer      Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  shift         Shift?                 @relation(fields: [shiftId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  items         SaleItem[]
  payments      Payment[]
  returns       Return[]
  movements     InventoryMovement[]
  containerTx   ContainerTransaction[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([channel, createdAt])
  @@index([cashierUserId, createdAt])
  @@index([branchId, createdAt])
  @@index([customerId, createdAt])
  @@index([status])
  @@index([receiptNumber])
}

model SaleItem {
  id           String         @id @default(cuid())
  saleId       String
  variantId    String
  name         String
  sku          String?
  quantity     Int
  unitPrice    Decimal        @db.Decimal(10, 2)
  costPrice    Decimal?       @db.Decimal(10, 2)
  discount     Decimal        @default(0) @db.Decimal(10, 2)
  discountType DiscountType?
  tax          Decimal        @default(0) @db.Decimal(10, 2)
  lineTotal    Decimal        @db.Decimal(10, 2)
  batchId      String?
  note         String?
  sale         Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([saleId])
  @@index([variantId])
}

model PaymentMethod {
  id        String    @id @default(cuid())
  name      String    @unique
  nameKh    String?
  type      String    @default("CASH")
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  payments  Payment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Payment {
  id              String         @id @default(cuid())
  saleId          String?
  orderId         String?
  paymentMethodId String?
  method          String
  branchId        String?
  amount          Decimal        @db.Decimal(10, 2)
  currency        String         @default("USD")
  exchangeRate    Decimal        @default(1) @db.Decimal(10, 4)
  baseAmount      Decimal        @db.Decimal(10, 2)
  reference       String?
  status          PaymentStatus  @default(PAID)
  note            String?
  qrString        String?
  qrMd5           String?
  deeplink        String?
  externalRef     String?
  transactionHash String?
  fromAccountId   String?
  toAccountId     String?
  description     String?
  expiresAt       DateTime?
  paidAt          DateTime?      @default(now())
  sale            Sale?          @relation(fields: [saleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  order           Order?         @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  branch          Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt

  @@unique([qrMd5])
  @@unique([externalRef])
  @@unique([transactionHash])
  @@index([saleId])
  @@index([orderId])
  @@index([branchId, createdAt])
  @@index([status])
  @@index([expiresAt])
}

model ContainerTransaction {
  id            String                   @id @default(cuid())
  customerId    String
  depositTypeId String
  branchId      String?
  saleId        String?
  type          ContainerTransactionType
  quantity      Int
  depositAmount Decimal                  @db.Decimal(10, 2)
  note          String?
  customer      Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  depositType   DepositType              @relation(fields: [depositTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch        Branch?                  @relation(fields: [branchId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sale          Sale?                    @relation(fields: [saleId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt     DateTime                 @default(now())

  @@index([customerId, createdAt])
  @@index([branchId, createdAt])
}

model Return {
  id           String       @id @default(cuid())
  returnNumber String?      @unique
  saleId       String
  cashierId    String
  branchId     String?
  reason       ReturnReason @default(OTHER)
  totalAmount  Decimal      @db.Decimal(10, 2)
  note         String?
  items        ReturnItem[]
  refunds      Refund[]
  sale         Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt    DateTime     @default(now())

  @@index([saleId])
}

model ReturnItem {
  id        String         @id @default(cuid())
  returnId  String
  variantId String
  quantity  Int
  unitPrice Decimal        @db.Decimal(10, 2)
  costPrice Decimal?       @db.Decimal(10, 2)
  reason    String?
  returnRef Return         @relation(fields: [returnId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([returnId])
  @@index([variantId])
}

model Refund {
  id            String   @id @default(cuid())
  returnId      String
  paymentMethod String
  amount        Decimal  @db.Decimal(10, 2)
  currency      String   @default("USD")
  exchangeRate  Decimal  @default(1) @db.Decimal(10, 4)
  baseAmount    Decimal  @db.Decimal(10, 2)
  reference     String?
  note          String?
  returnRef     Return   @relation(fields: [returnId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt     DateTime @default(now())

  @@index([returnId])
}

// ==========================================
// 7. ONLINE STORE & E-COMMERCE
// ==========================================

model Cart {
  id         String     @id @default(cuid())
  customerId String?
  sessionId  String?
  branchId   String?
  couponCode String?
  subtotal   Decimal    @default(0) @db.Decimal(10, 2)
  total      Decimal    @default(0) @db.Decimal(10, 2)
  expiresAt  DateTime?
  items      CartItem[]
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([customerId])
  @@index([sessionId])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  unitPrice Decimal        @db.Decimal(10, 2)
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  addedAt   DateTime       @default(now())

  @@unique([cartId, variantId])
  @@index([cartId])
}

model Order {
  id                String               @id @default(cuid())
  orderNumber       String               @unique
  userId            String?
  customerId        String?
  branchId          String?
  channel           SalesChannel         @default(ONLINE)
  status            OrderStatus          @default(PENDING)
  paymentMethod     String               @default("CASH_ON_DELIVERY")
  paymentStatus     PaymentStatus        @default(PENDING)
  currency          String               @default("USD")
  exchangeRate      Decimal              @default(1) @db.Decimal(10, 4)
  subtotal          Decimal              @db.Decimal(10, 2)
  discountAmount    Decimal              @default(0) @db.Decimal(10, 2)
  shippingFee       Decimal              @default(0) @db.Decimal(10, 2)
  taxAmount         Decimal              @default(0) @db.Decimal(10, 2)
  total             Decimal              @db.Decimal(10, 2)
  couponCode        String?
  couponType        CouponType?
  couponValue       Decimal?             @db.Decimal(10, 2)
  couponDiscount    Decimal?             @db.Decimal(10, 2)
  trackingNumber    String?
  trackingCarrier   String?
  trackingStatus    String?
  trackingUpdatedAt DateTime?
  shippingAddress   String?
  note              String?
  user              User?                @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  customer          Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  branch            Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  items             OrderItem[]
  // Backward compatibility alias
  lines             OrderLine[]
  movements         InventoryMovement[]
  statusHistory     OrderStatusHistory[]
  delivery          Delivery?
  payments          Payment[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([channel, status, createdAt])
  @@index([customerId, createdAt])
  @@index([orderNumber])
  @@index([paymentStatus])
}

model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  variantId      String
  productName    String
  variantName    String
  sku            String?
  quantity       Int
  unitPrice      Decimal        @db.Decimal(10, 2)
  costPrice      Decimal?       @db.Decimal(10, 2)
  discountAmount Decimal        @default(0) @db.Decimal(10, 2)
  taxAmount      Decimal        @default(0) @db.Decimal(10, 2)
  lineTotal      Decimal        @db.Decimal(10, 2)
  note           String?
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([orderId])
  @@index([variantId])
}

// Retained for backward compatibility with existing code
model OrderLine {
  id              String  @id @default(cuid())
  orderId         String
  productId       String
  productName     String
  quantity        Int
  unitPrice       Decimal @db.Decimal(10, 2)
  discountPercent Int     @default(0)
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([orderId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  changedBy String?
  note      String?
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime    @default(now())

  @@index([orderId])
}

model DeliveryZone {
  id            String     @id @default(cuid())
  name          String
  nameKh        String?
  description   String?
  baseFee       Decimal    @db.Decimal(10, 2)
  perKmFee      Decimal    @default(0) @db.Decimal(10, 2)
  estimatedDays Int        @default(1)
  isActive      Boolean    @default(true)
  deliveries    Delivery[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Driver {
  id           String       @id @default(cuid())
  name         String
  nameKh       String?
  phoneNumber  String       @unique
  vehicleType  String?
  vehiclePlate String?
  status       DriverStatus @default(AVAILABLE)
  isActive     Boolean      @default(true)
  deliveries   Delivery[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  @@index([status, isActive])
}

model Delivery {
  id             String         @id @default(cuid())
  orderId        String         @unique
  driverId       String?
  deliveryZoneId String?
  status         DeliveryStatus @default(PENDING)
  address        String
  lat            Decimal?       @db.Decimal(10, 7)
  lng            Decimal?       @db.Decimal(10, 7)
  fee            Decimal        @default(0) @db.Decimal(10, 2)
  scheduledAt    DateTime?
  pickedUpAt     DateTime?
  deliveredAt    DateTime?
  note           String?
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  driver         Driver?        @relation(fields: [driverId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  deliveryZone   DeliveryZone?  @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([driverId, status])
  @@index([status])
}

model Coupon {
  id             String         @id @default(cuid())
  code           String         @unique
  type           CouponType
  value          Decimal        @db.Decimal(10, 2)
  minPurchase    Decimal?       @db.Decimal(10, 2)
  maxDiscount    Decimal?       @db.Decimal(10, 2)
  audience       CouponAudience @default(EVERYONE)
  userEmail      String?
  customerTypeId String?
  usageLimit     Int?
  usageCount     Int            @default(0)
  perUserLimit   Int?
  description    String?
  isActive       Boolean        @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([code])
  @@index([isActive, startsAt, endsAt])
}

model Promotion {
  id            String          @id @default(cuid())
  name          String
  type          PromotionType
  discountType  DiscountType    @default(PERCENTAGE)
  discountValue Decimal         @db.Decimal(10, 2)
  minQty        Int?
  bonusQty      Int?
  minPurchase   Decimal?        @db.Decimal(10, 2)
  maxDiscount   Decimal?        @db.Decimal(10, 2)
  branchId      String?
  startTime     DateTime?
  endTime       DateTime?
  startHour     Int?
  endHour       Int?
  isActive      Boolean         @default(true)
  items         PromotionItem[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([isActive, startTime, endTime])
}

model PromotionItem {
  id          String    @id @default(cuid())
  promotionId String
  productId   String?
  variantId   String?
  categoryId  String?
  brandId     String?
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product     Product?  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([promotionId])
  @@index([productId])
}

model ProductReview {
  id         String   @id @default(cuid())
  productId  String
  customerId String?
  userId     String?
  rating     Int
  title      String?
  body       String?
  isVerified Boolean  @default(false)
  isApproved Boolean  @default(false)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId, isApproved])
}

// ==========================================
// 8. FINANCE
// ==========================================

model ExpenseCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  expenses    Expense[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Expense {
  id                String          @id @default(cuid())
  branchId          String
  userId            String
  expenseCategoryId String
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("USD")
  exchangeRate      Decimal         @default(1) @db.Decimal(10, 4)
  baseAmount        Decimal         @db.Decimal(10, 2)
  description       String
  receiptUrl        String?
  expenseDate       DateTime        @default(now())
  branch            Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  expenseCategory   ExpenseCategory @relation(fields: [expenseCategoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([branchId, expenseDate])
  @@index([expenseCategoryId])
}

model ExchangeRate {
  id            String   @id @default(cuid())
  fromCurrency  String
  toCurrency    String
  rate          Decimal  @db.Decimal(14, 6)
  source        String   @default("MANUAL")
  effectiveDate DateTime @default(now())
  createdAt     DateTime @default(now())

  @@unique([fromCurrency, toCurrency, effectiveDate])
  @@index([fromCurrency, toCurrency, effectiveDate])
}

// ==========================================
// 9. OFFLINE SYNC
// ==========================================

model SyncQueue {
  id         String     @id @default(cuid())
  deviceId   String
  userId     String?
  branchId   String?
  entityType String
  entityId   String?
  operation  String
  payload    Json
  status     SyncStatus @default(PENDING)
  retryCount Int        @default(0)
  maxRetries Int        @default(5)
  errorMsg   String?
  syncedAt   DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([deviceId, status])
  @@index([branchId, status])
  @@index([status, createdAt])
  @@index([entityType, entityId])
}

model SyncConflict {
  id            String    @id @default(cuid())
  syncQueueId   String?
  deviceId      String
  entityType    String
  entityId      String?
  clientVersion Json
  serverVersion Json
  resolvedBy    String?
  resolvedAt    DateTime?
  resolution    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([deviceId])
  @@index([entityType, entityId])
}

// ==========================================
// 10. COMMUNITY (retained for backward compat)
// ==========================================

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Comment {
  id        String   @id @default(cuid())
  productId String
  userId    String
  message   String
  rating    Int?
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user      User     @relation("CommentAuthor", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model SupportTicket {
  id        String           @id @default(cuid())
  userId    String
  subject   String
  status    String           @default("OPEN")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  messages  SupportMessage[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, status])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  userId    String
  message   String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime      @default(now())

  @@index([ticketId])
}
